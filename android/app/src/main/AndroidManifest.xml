<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <queries>
    <intent>
        <action android:name="android.speech.RecognitionService" />
    </intent>
    </queries>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BILLING & TRACKING                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- AD_ID ist für Apps mit Kinder-Zielgruppe verboten (Play Families
         Policy). RevenueCat funktioniert ohne. tools:node="remove" strippt
         die Permission auch aus gemergten SDK-Manifesten. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- c2dm.RECEIVE und WAKE_LOCK im fertigen Paket kommen über
         cloud_functions → firebase-functions → firebase-iid mit. Lerndex
         schickt keine Push-Nachrichten; bewusst NICHT entfernt, weil
         firebase-iid bei Functions-Aufrufen intern ein Token holt. -->

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- KAMERA                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Kamera ist optional: Geräte ohne Kamera (z.B. Chromebooks) werden
         nicht ausgeschlossen. Die Kamera-Funktion (Aufgaben fotografieren)
         ist nur im Eltern-Bereich verfügbar und nicht kernfunktional. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FOTO / GALERIE-ZUGRIFF                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- KEINE Medien-Permissions: Die Galerie-Auswahl läuft über den
         System-Photo-Picker (image_picker mit useAndroidPhotoPicker),
         der ohne READ_MEDIA_IMAGES/READ_EXTERNAL_STORAGE auskommt.
         Play-Policy verbietet diese Permissions bei nur gelegentlichem
         Medienzugriff (Play-Rejection vom 16.07.2026). -->

    <!-- Keine Auto-Sicherung: Auf Kinder-, Schüler- und Lehrergeräten liegt
         die Anmeldung im App-Speicher. Eine Sicherung (Google-Konto) oder die
         Übertragung auf ein neues Gerät würde sie mitnehmen.
         dataExtractionRules gilt ab Android 12, allowBackup davor. -->
    <application
        android:label="Lerndex"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links: Die QR-Codes und Karten zeigen auf app.lerndex.de.
                 Mit der Kamera gescannt, öffnet Android direkt die App statt
                 des Browsers. Bestätigt wird das über
                 https://app.lerndex.de/.well-known/assetlinks.json (dort
                 stehen die Fingerabdrücke der Signaturschlüssel). Gelesen
                 werden die Links im Dart-Code mit app_links
                 (lib/src/shared/app_links.dart). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="app.lerndex.de"/>
                <!-- Kind koppeln, Schülerkarte, Lehrerkarte, Elternbrief,
                     Schul-Einladung -->
                <data android:pathPrefix="/k/"/>
                <data android:pathPrefix="/s/"/>
                <data android:pathPrefix="/l/"/>
                <data android:pathPrefix="/e/"/>
                <data android:pathPrefix="/schule/"/>
            </intent-filter>
            <!-- Links liest app_links, nicht Flutters eingebautes Deep-Linking
                 (das würde /k/CODE als Seite der App öffnen wollen). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>