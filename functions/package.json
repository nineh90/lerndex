{
  "name": "lerndex-functions",
  "private": true,
  "description": "Cloud Functions für Lerndex: Kindergeräte koppeln, Eltern-PIN",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\"",
    "test:emulator": "firebase emulators:exec --project demo-lerndex --only auth,firestore,functions,storage \"npm test\"",
    "deploy": "firebase deploy --project lerndex-3775f --only functions:createPairingCode,functions:redeemPairingCode,functions:unpairChildDevices,functions:verifyParentPin,functions:setParentPin,functions:cleanupDeletedParent,functions:createSchool,functions:createTeacherInvite,functions:joinSchool,functions:removeTeacher,functions:createStudentCards,functions:redeemStudentCard,functions:revokeStudent,functions:deleteStudent"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0"
  }
}
