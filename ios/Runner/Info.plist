<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Lerndex</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>lerndex</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- ORIENTIERUNG                                                -->
		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- BUGFIX: Key fehlte komplett in der originalen Datei        -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- BERECHTIGUNGEN (Privacy – Pflicht für App Store Review)    -->
		<!-- ═══════════════════════════════════════════════════════════ -->

		<!-- Kamera: Foto-Upload für KI-Aufgabengenerierung -->
		<key>NSCameraUsageDescription</key>
		<string>Lerndex benötigt die Kamera um Schulaufgaben zu fotografieren und daraus Quiz-Fragen zu generieren.</string>

		<!-- Fotobibliothek: Bild hochladen -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Lerndex benötigt Zugriff auf deine Fotos um Schulaufgaben hochzuladen.</string>

		<!-- Hinweis: Der Mikrofon-Nutzungstext steht weiter unten (Spracheingabe Tutor) -->

		<!-- Tracking: Pflicht wegen RevenueCat (IDFA). Ohne diesen Key lehnt Apple die App ab. -->
		<!-- Wenn ihr kein personalisiertes Tracking wollt: einfach so lassen, ATT-Dialog erscheint nicht -->
		<key>NSUserTrackingUsageDescription</key>
		<string>Lerndex nutzt diese Information ausschließlich um Käufe korrekt zu verarbeiten und dir passende Abo-Angebote anzuzeigen.</string>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- APP STORE / EXPORT COMPLIANCE                              -->
		<!-- ═══════════════════════════════════════════════════════════ -->

		<!-- Verhindert den manuellen "Export Compliance"-Dialog bei jedem Upload zu TestFlight.  -->
		<!-- Firebase/TLS nutzt Standard-HTTPS – keine eigene Verschlüsselung → false ist korrekt -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- UI / SYSTEM                                                 -->
		<!-- ═══════════════════════════════════════════════════════════ -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>

		<!-- URL-Schemes für Google Sign-In und externe Links -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>http</string>
		</array>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- GOOGLE SIGN-IN: Rückleitungs-URL-Scheme                     -->
		<!-- ═══════════════════════════════════════════════════════════ -->
		<!-- WICHTIG (manueller Schritt auf dem Mac):                    -->
		<!-- Den Platzhalter unten durch den Wert REVERSED_CLIENT_ID aus -->
		<!-- der GoogleService-Info.plist (Firebase-Konsole → iOS-App)   -->
		<!-- ersetzen. Format: com.googleusercontent.apps.<ID>           -->
		<!-- Ohne diesen Eintrag kehrt der Google-Login nicht in die App -->
		<!-- zurück (weißer Bildschirm nach Auswahl des Google-Kontos).  -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.REVERSED_CLIENT_ID_HIER_EINTRAGEN</string>
				</array>
			</dict>
		</array>
		<key>NSMicrophoneUsageDescription</key>
<string>Lerndex benötigt das Mikrofon, damit dein Kind seine Frage an den Tutor sprechen kann.</string>
<key>NSSpeechRecognitionUsageDescription</key>
<string>Lerndex nutzt die Spracherkennung, um gesprochene Fragen in Text umzuwandeln. Audiodaten werden nicht gespeichert.</string>
	</dict>
</plist>
